<?xml version="1.0"?>
<launch>
    <arg name="start"       default="true"/>
    <arg name="category"    default="shape"/>
    <!--底盘驱动(chassis driver)-->
    <include file="$(find hiwonder_controller)/launch/hiwonder_controller.launch"/>
    <include file="$(find hiwonder_peripherals)/launch/depth_cam.launch"/>
    <include file="$(find hiwonder_kinematics)/launch/kinematics_node.launch"/>
    <node pkg="hiwonder_example" type="object_classification.py" name="object_classification" output="screen">
        <param name="start" value="$(arg start)"/>
        <param name="category" value="$(arg category)"/>
    </node>
</launch>
