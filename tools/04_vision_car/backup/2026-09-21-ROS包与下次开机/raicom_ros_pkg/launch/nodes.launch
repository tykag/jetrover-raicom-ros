<?xml version="1.0"?>
<!-- YOLO + 抓放状态机。导航已经在跑时只起这个。 -->
<launch>
    <arg name="side"       default="A"/>
    <arg name="task"       default="full"/>
    <arg name="skip_nav"   default="false"/>
    <arg name="cycles"     default="2"/>
    <arg name="allow_high" default="false"/>
    <arg name="show_yolo"  default="false"/>

    <env name="OPENBLAS_CORETYPE" value="ARMV8"/>
    <env name="PYTHONUNBUFFERED" value="1"/>
    <env name="LD_PRELOAD" value="/usr/lib/aarch64-linux-gnu/libgomp.so.1"/>

    <node pkg="raicom" type="raicom_yolo_trt.py" name="raicom_yolo" output="screen">
        <param name="show" value="$(arg show_yolo)"/>
    </node>

    <node pkg="raicom" type="raicom_auto.py" name="raicom_auto" output="screen">
        <param name="side"       value="$(arg side)"/>
        <param name="task"       value="$(arg task)"/>
        <param name="skip_nav"   value="$(arg skip_nav)"/>
        <param name="cycles"     value="$(arg cycles)"/>
        <param name="allow_high" value="$(arg allow_high)"/>
    </node>
</launch>
